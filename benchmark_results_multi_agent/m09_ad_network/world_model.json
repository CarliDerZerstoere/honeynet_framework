          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "bid_cache",
          "campaign_db"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 80 || (echo > /dev/tcp/localhost/80) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "adserver.public.programmaticad.internal",
