            ]
          }
        ],
        "hostname": "web01.public.three_tier_web_stack.internal",
        "env": [
          "database__client=mysql",
          "database__connection__host=your-database-host",
          "database__connection__user=your-database-user",
          "database__connection__password=your-database-password",
          "database__connection__database=your-database-name",
          "NODE_ENV=production",
          "GHOST_INSTALL=/var/lib/ghost",
          "GHOST_CONTENT=/var/lib/ghost/content",
          "GHOST_VERSION=5.130.6",
          "GHOST_CLI_VERSION=1.28.4",
          "GOSU_VERSION=1.19",
          "YARN_VERSION=1.22.22",
          "NODE_VERSION=20.20.0",
          "DATABASE_HOST=your-database-host"
        ],
        "depends_on": [
          "docker_container.hn_redis_cache",
          "docker_container.hn_postgres_db"
        ],
        "command": [
          "node",
          "current/index.js"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "three_tier_web_stack"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "curl -sf http://localhost:2368 || wget -qO- http://localhost:2368 || true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
