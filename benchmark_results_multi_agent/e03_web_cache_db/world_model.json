{
  "zones": {
    "public_zone": {
      "name": "public_zone",
      "deploy": {
        "network_name": "public_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "monitoring_zone": {
      "name": "monitoring_zone",
      "deploy": {
        "network_name": "monitoring_zone",
        "driver": "bridge",
        "internal": true
      }
    }
  },
  "systems": {
    "web_server": {
      "name": "web_server",
      "kind": "web",
      "deploy": {
        "image": "ghost:5",
        "zone": "data_zone",
        "ports": [
          2368
        ],
        "env": [
          "database__client=mysql",
          "database__connection__host=your-database-host",
          "database__connection__user=your-database-user",
          "database__connection__password=your-database-password",
          "database__connection__database=your-database-name",
          "NODE_ENV=production",
          "GHOST_INSTALL=/var/lib/ghost",
          "GHOST_CONTENT=/var/lib/ghost/content",
          "GHOST_VERSION=5.130.6",
          "GHOST_CLI_VERSION=1.28.4",
          "GOSU_VERSION=1.19",
          "YARN_VERSION=1.22.22",
          "NODE_VERSION=20.20.0",
          "DATABASE_HOST=your-database-host"
        ],
        "volumes": [],
        "depends_on": [
          "redis_cache",
          "postgres_db"
        ],
        "command": [
          "node",
          "current/index.js"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost:2368 || wget -qO- http://localhost:2368 || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "web01.public.three_tier_web_stack.internal",
        "role": "Public-facing web application server",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
