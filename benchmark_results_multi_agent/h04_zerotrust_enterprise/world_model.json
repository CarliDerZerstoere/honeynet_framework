      "deploy": {
        "image": "hashicorp/vault:1.15",
        "zone": "secrets_zone",
        "ports": [
          8200
        ],
        "env": [
          "VERSION=1.15.6"
        ],
        "volumes": [],
        "depends_on": [],
        "command": [
          "server",
          "-dev"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "vault",
            "status"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "honeytoken-vault.secrets.zero_trust_enterprise.internal",
