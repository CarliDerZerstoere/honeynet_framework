  "systems": {
    "vault_audit_log_consumer": {
      "name": "vault_audit_log_consumer",
      "kind": "unknown",
      "deploy": {
        "image": "grafana/loki:2.9.3",
        "zone": "security_zone",
        "ports": [
          3100
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 3100 || (echo > /dev/tcp/localhost/3100) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "vault-audit.security.zero_trust_enterprise.internal",
        "role": "Consumes and processes Vault audit logs",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "postgresql_primary": {
      "name": "postgresql_primary",
      "kind": "database",
      "deploy": {
        "image": "postgres:16-alpine",
        "zone": "data_zone",
        "ports": [
          5432
        ],
        "env": [
          "POSTGRES_PASSWORD=weakpassword"
        ],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "pg_isready",
            "-U",
            "postgres"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "db-primary.data.zero_trust_enterprise.internal",
        "role": "Primary PostgreSQL database",
        "issues": [],
        "secrets": [
          "db_admin_password"
        ],
        "behaviors": [],
        "services": []
      }
    },
