      "corporate_application_data_zone": {
        "name": "corporate_application_data_zone",
        "driver": "bridge",
        "internal": true
      },
      "corporate_application_mgmt_zone": {
        "name": "corporate_application_mgmt_zone",
        "driver": "bridge",
        "internal": true
      },
      "corporate_application_honeynet_backbone": {
        "name": "corporate_application_honeynet_backbone",
        "driver": "bridge",
        "internal": false
      }
    },
    "docker_image": {
      "hn_web_frontend": {
        "name": "wordpress@sha256:8ae66efb09a2cc4f1ce44414c52b0ce4198c1f8ed338a6f51910bc09cd7d8bbb",
        "keep_locally": true
      },
      "hn_reverse_proxy": {
        "name": "nginx@sha256:516475cc129da42866742567714ddc681e5eed7b9ee0b9e9c015e464b4221a00",
        "keep_locally": true
      },
      "hn_postgres_db": {
        "name": "postgres@sha256:20edbde7749f822887a1a022ad526fde0a47d6b2be9a8364433605cf65099416",
        "keep_locally": true
      },
      "hn_admin_panel": {
        "name": "adminer@sha256:aedd36aebf9352b435a2657f0a1e51fc6ac054dd838f42aee2a79ce059a1d796",
