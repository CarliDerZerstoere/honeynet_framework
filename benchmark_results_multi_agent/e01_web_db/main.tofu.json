    "docker_container": {
      "hn_web_frontend": {
        "name": "hn_web_frontend",
        "image": "${docker_image.hn_web_frontend.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.corporate_application_public_zone.name}",
            "aliases": [
              "web_frontend"
            ]
          },
          {
            "name": "${docker_network.corporate_application_data_zone.name}",
            "aliases": [
              "web_frontend"
            ]
          }
        ],
        "hostname": "web01.public.corporate_application.internal",
        "ports": [
          {
            "internal": 80,
            "external": 1027,
            "protocol": "tcp"
          }
        ],
        "depends_on": [
          "docker_container.hn_postgres_db"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "corporate_application"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD",
              "curl",
              "-f",
              "http://localhost/"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_reverse_proxy": {
        "name": "hn_reverse_proxy",
        "image": "${docker_image.hn_reverse_proxy.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.corporate_application_public_zone.name}",
            "aliases": [
              "reverse_proxy"
            ]
          }
        ],
        "hostname": "proxy01.public.corporate_application.internal",
        "ports": [
          {
            "internal": 80,
            "external": 1028,
            "protocol": "tcp"
          }
        ],
        "depends_on": [
          "docker_container.hn_web_frontend"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "corporate_application"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD",
              "curl",
              "-f",
              "http://localhost/"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_postgres_db": {
        "name": "hn_postgres_db",
        "image": "${docker_image.hn_postgres_db.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.corporate_application_data_zone.name}",
            "aliases": [
              "postgres_db"
            ]
          }
        ],
        "hostname": "db01.data.corporate_application.internal",
        "env": [
          "POSTGRES_PASSWORD=admin123"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "corporate_application"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD",
              "pg_isready",
              "-U",
              "postgres"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_admin_panel": {
        "name": "hn_admin_panel",
        "image": "${docker_image.hn_admin_panel.image_id}",
