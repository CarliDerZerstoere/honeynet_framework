          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "curl -sf http://localhost:8080/ || wget -qO- http://localhost:8080/ || true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_pgadmin": {
        "name": "hn_pgadmin",
