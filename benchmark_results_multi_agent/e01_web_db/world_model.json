{
  "zones": {
    "public_zone": {
      "name": "public_zone",
      "deploy": {
        "network_name": "public_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "mgmt_zone": {
      "name": "mgmt_zone",
      "deploy": {
        "network_name": "mgmt_zone",
        "driver": "bridge",
        "internal": true
      }
    }
  },
