{
  "zones": {
    "build_zone": {
      "name": "build_zone",
      "deploy": {
        "network_name": "build_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "monitoring_zone": {
      "name": "monitoring_zone",
      "deploy": {
        "network_name": "monitoring_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "public_zone": {
      "name": "public_zone",
      "deploy": {
        "network_name": "public_zone",
        "driver": "bridge",
        "internal": false
      }
    }
  },
  "systems": {
    "ci_runner": {
      "name": "ci_runner",
      "kind": "runtime",
      "deploy": {
        "image": "jenkins/jenkins@sha256:c4098086090ca98491d4bf66182f5e3b015a8232f2acf2df209a212a5801aa8e",
        "zone": "build_zone",
        "ports": [
          50000,
          8080
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "minio_storage",
          "postgres_database"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost:8080 || wget -qO- http://localhost:8080 || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "ci-runner.build.continuousintegration.internal",
        "role": "Build runner executing CI pipelines",
        "issues": [],
        "secrets": [
          "jenkins_admin_password"
        ],
        "behaviors": [],
        "services": []
      }
    },
    "minio_storage": {
      "name": "minio_storage",
      "kind": "storage",
      "deploy": {
        "image": "minio/minio:latest",
        "zone": "data_zone",
        "ports": [
          9000
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "command": [
          "minio",
          "server",
          "/data"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 9000 || (echo > /dev/tcp/localhost/9000) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "minio.data.continuousintegration.internal",
        "role": "Object store for caching build artifacts",
        "issues": [],
        "secrets": [
          "minio_access_key",
          "minio_secret_key"
        ],
        "behaviors": [],
        "services": []
      }
    },
    "postgres_database": {
      "name": "postgres_database",
      "kind": "database",
      "deploy": {
        "image": "postgres:16-alpine",
        "zone": "data_zone",
        "ports": [
          5432
        ],
        "env": [
          "POSTGRES_PASSWORD=admin123"
        ],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "pg_isready",
            "-U",
            "postgres"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "postgres.data.continuousintegration.internal",
        "role": "Database tracking job results and pipeline metadata",
        "issues": [],
        "secrets": [
          "postgres_user_password"
        ],
        "behaviors": [],
        "services": []
      }
    },
    "ci_web_interface": {
      "name": "ci_web_interface",
      "kind": "web",
      "deploy": {
        "image": "nginx:1.25-alpine",
        "zone": "public_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "ci_runner"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost:80 || wget -qO- http://localhost:80 || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "ci-web.public.continuousintegration.internal",
        "role": "Web interface for CI system",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "ci_proxy": {
      "name": "ci_proxy",
      "kind": "web",
      "deploy": {
        "image": "nginx@sha256:516475cc129da42866742567714ddc681e5eed7b9ee0b9e9c015e464b4221a00",
        "zone": "public_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
