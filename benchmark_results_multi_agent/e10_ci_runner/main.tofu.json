    "docker_container": {
      "hn_ci_runner": {
        "name": "hn_ci_runner",
        "image": "${docker_image.hn_ci_runner.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.continuous_integration_environment_build_zone.name}",
            "aliases": [
              "ci_runner"
            ]
          },
          {
            "name": "${docker_network.continuous_integration_environment_data_zone.name}",
            "aliases": [
              "ci_runner"
            ]
          }
        ],
        "hostname": "ci-runner.build.continuousintegration.internal",
        "depends_on": [
          "docker_container.hn_minio_storage",
          "docker_container.hn_postgres_database"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "continuous_integration_environment"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "curl -sf http://localhost:8080 || wget -qO- http://localhost:8080 || true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_minio_storage": {
        "name": "hn_minio_storage",
        "image": "${docker_image.hn_minio_storage.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.continuous_integration_environment_data_zone.name}",
            "aliases": [
              "minio_storage"
            ]
          }
        ],
        "hostname": "minio.data.continuousintegration.internal",
        "command": [
          "minio",
          "server",
          "/data"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "continuous_integration_environment"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "nc -z localhost 9000 || (echo > /dev/tcp/localhost/9000) 2>/dev/null || true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
