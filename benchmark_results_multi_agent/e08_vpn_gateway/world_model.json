{
  "zones": {
    "edge_zone": {
      "name": "edge_zone",
      "deploy": {
        "network_name": "edge_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "internal_zone": {
      "name": "internal_zone",
      "deploy": {
        "network_name": "internal_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "monitoring_zone": {
      "name": "monitoring_zone",
      "deploy": {
        "network_name": "monitoring_zone",
        "driver": "bridge",
        "internal": true
      }
    }
  },
  "systems": {
    "auth_proxy": {
      "name": "auth_proxy",
      "kind": "identity",
      "deploy": {
        "image": "osixia/openldap:1.5.0",
        "zone": "internal_zone",
        "ports": [
          389,
          636
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 389 || (echo > /dev/tcp/localhost/389) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "auth.edge.corporate_remote_access.internal",
        "role": "Authentication proxy for validating credentials",
        "issues": [],
        "secrets": [
          "ldap_admin_password"
        ],
        "behaviors": [],
        "services": []
      }
    },
    "internal_wiki": {
      "name": "internal_wiki",
      "kind": "web",
      "deploy": {
        "image": "caddy:2",
        "zone": "internal_zone",
        "ports": [
          80,
          443
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "auth_proxy"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 2019 || (echo > /dev/tcp/localhost/2019) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "wiki.internal.corporate_remote_access.internal",
        "role": "Internal wiki with corporate documents",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "log_collector": {
      "name": "log_collector",
      "kind": "monitor",
      "deploy": {
        "image": "elasticsearch:8.11.0",
        "zone": "monitoring_zone",
        "ports": [
          9200,
          9300
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost:9200/_cluster/health || wget -qO- http://localhost:9200/_cluster/health || true"
