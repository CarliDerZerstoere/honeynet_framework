      "name": "inference_api",
      "kind": "web",
      "deploy": {
        "image": "nginx:1.25-alpine",
        "zone": "public_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "model_registry",
          "feature_store"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost/ || wget -qO- http://localhost/ || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "inference-api.production_ml_platform.internal",
        "role": "Model inference REST API",
        "issues": [],
        "secrets": [
          "model_api_key"
        ],
        "behaviors": [],
        "services": []
      }
    },
