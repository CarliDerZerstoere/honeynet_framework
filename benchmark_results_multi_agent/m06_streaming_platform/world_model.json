{
  "zones": {
    "internal_zone": {
      "name": "internal_zone",
      "deploy": {
        "network_name": "internal_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "api_zone": {
      "name": "api_zone",
      "deploy": {
        "network_name": "api_zone",
        "driver": "bridge",
        "internal": false
      }
    }
