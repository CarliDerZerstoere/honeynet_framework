    "zookeeper": {
      "name": "zookeeper",
      "kind": "infra",
      "deploy": {
        "image": "zookeeper:3.8",
        "zone": "internal_zone",
        "ports": [
          2181
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 2181 || (echo > /dev/tcp/localhost/2181) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "zookeeper01.internal.realtimeplatform.internal",
        "role": "Coordination service for Kafka cluster",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
