{
  "zones": {
    "dmz_zone": {
      "name": "dmz_zone",
      "deploy": {
        "network_name": "dmz_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "core_zone": {
      "name": "core_zone",
      "deploy": {
        "network_name": "core_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "identity_zone": {
      "name": "identity_zone",
      "deploy": {
        "network_name": "identity_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "compliance_zone": {
      "name": "compliance_zone",
      "deploy": {
        "network_name": "compliance_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "ops_zone": {
      "name": "ops_zone",
      "deploy": {
        "network_name": "ops_zone",
        "driver": "bridge",
        "internal": true
      }
    }
  },
  "systems": {
    "nginx_api_gateway": {
      "name": "nginx_api_gateway",
      "kind": "web",
      "deploy": {
        "image": "nginx:1.25-alpine",
        "zone": "dmz_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost/"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "api-gateway.dmz.financialinstitution.internal",
        "role": "API Gateway for routing external requests to internal services",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "public_web_banking_portal": {
      "name": "public_web_banking_portal",
      "kind": "web",
      "deploy": {
        "image": "nginx:1.25-alpine",
        "zone": "dmz_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost/"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "web-banking.dmz.financialinstitution.internal",
        "role": "Public-facing web portal for customer banking access",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "postgresql_ledger_db": {
      "name": "postgresql_ledger_db",
      "kind": "database",
      "deploy": {
        "image": "postgres:16-alpine",
        "zone": "data_zone",
        "ports": [
          5432
        ],
        "env": [
          "POSTGRES_PASSWORD=admin123"
        ],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "pg_isready",
            "-U",
            "postgres"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "ledger-db.data.financialinstitution.internal",
        "role": "Database for storing financial transaction records",
        "issues": [],
        "secrets": [
          "admin_db_credentials"
        ],
        "behaviors": [],
        "services": []
      }
    },
    "kafka_event_bus": {
      "name": "kafka_event_bus",
      "kind": "queue",
      "deploy": {
        "image": "apache/kafka:3.7.0",
        "zone": "data_zone",
        "ports": [
          9092
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 9092 || (echo > /dev/tcp/localhost/9092) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "event-bus.data.financialinstitution.internal",
        "role": "Event bus for handling transaction events",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "audit_logging_service": {
      "name": "audit_logging_service",
      "kind": "storage",
      "deploy": {
        "image": "fluent/fluentd:v1.16",
        "zone": "compliance_zone",
        "ports": [
          24224,
          5140
        ],
        "env": [
          "LD_PRELOAD=/usr/lib/libjemalloc.so.2"
        ],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 24224 || (echo > /dev/tcp/localhost/24224) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "audit-logs.compliance.financialinstitution.internal",
        "role": "Service for collecting and storing audit logs",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "prometheus_monitoring": {
      "name": "prometheus_monitoring",
      "kind": "monitor",
      "deploy": {
        "image": "prom/prometheus:v2.48.0",
        "zone": "ops_zone",
        "ports": [
          9090
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost:9090/-/healthy || wget -qO- http://localhost:9090/-/healthy || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "prometheus.ops.financialinstitution.internal",
        "role": "Monitoring system for collecting metrics",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "honeytoken_admin_db_credentials": {
      "name": "honeytoken_admin_db_credentials",
      "kind": "unknown",
      "deploy": {
        "image": "postgres:16-alpine",
        "zone": "data_zone",
        "ports": [
          5432
        ],
        "env": [
          "POSTGRES_PASSWORD=admin123"
        ],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "pg_isready",
            "-U",
            "postgres"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "honeytoken-db-credentials.data.financialinstitution.internal",
        "role": "Decoy system for detecting unauthorized database access",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    }
