      "kind": "web",
      "deploy": {
        "image": "wordpress:6.4-php8.2-apache",
        "zone": "public_dmz",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "case_management_api"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost/ || wget -qO- http://localhost/ || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "portal.national.gov",
        "role": "Public-facing citizen portal",
        "issues": [],
        "secrets": [],
