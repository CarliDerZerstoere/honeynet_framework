      "deploy": {
        "image": "nginx:1.25-alpine",
        "zone": "command_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost/ || wget -qO- http://localhost/ || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "command-portal.command.military.internal",
