{
  "zones": {
    "dns_zone": {
      "name": "dns_zone",
      "deploy": {
        "network_name": "dns_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "logging_zone": {
      "name": "logging_zone",
      "deploy": {
        "network_name": "logging_zone",
        "driver": "bridge",
        "internal": true
      }
    }
  },
  "systems": {
    "dns_resolver": {
      "name": "dns_resolver",
      "kind": "infra",
      "deploy": {
        "image": "caddy:2",
        "zone": "dns_zone",
        "ports": [
          2019,
          443,
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 80 || (echo > /dev/tcp/localhost/80) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "dns01.dns_sinkhole_environment.internal",
        "role": "Recursive DNS resolver redirecting suspicious domains",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "sinkhole_web": {
      "name": "sinkhole_web",
      "kind": "web",
      "deploy": {
        "image": "nginx:1.25-alpine",
        "zone": "dns_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "dns_resolver"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost:80 || wget -qO- http://localhost:80 || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "sinkhole.dns_sinkhole_environment.internal",
        "role": "Web server capturing and logging incoming requests",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
