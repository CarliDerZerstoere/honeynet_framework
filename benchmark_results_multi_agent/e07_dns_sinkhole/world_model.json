      "name": "log_collector",
      "kind": "monitor",
      "deploy": {
        "image": "jaegertracing/all-in-one:1.52",
        "zone": "logging_zone",
        "ports": [
          14250,
          14268,
          16686,
          4317,
          4318,
          5775,
          5778,
          6831,
          6832,
          9411
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "sinkhole_web"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 16686 || (echo > /dev/tcp/localhost/16686) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "logs.dns_sinkhole_environment.internal",
        "role": "Collects and aggregates logs for analysis",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
