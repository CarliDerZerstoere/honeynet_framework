{
  "zones": {
    "internal_zone": {
      "name": "internal_zone",
      "deploy": {
        "network_name": "internal_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "build_zone": {
      "name": "build_zone",
      "deploy": {
        "network_name": "build_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    }
  },
  "systems": {
    "gitea": {
      "name": "gitea",
      "kind": "web",
      "deploy": {
        "image": "gitea/gitea:latest",
        "zone": "internal_zone",
        "ports": [
          3000,
          22
        ],
        "env": [
          "GITEA__database__DB_TYPE=sqlite3",
          "GITEA__database__PATH=data/gitea.db",
          "GITEA__security__INSTALL_LOCK=true",
          "GITEA__security__SECRET_KEY=weaksecretkey"
        ],
        "volumes": [],
        "depends_on": [
          "ci_database"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost:3000/ || wget -qO- http://localhost:3000/ || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "gitea.internal_developer_platform.internal",
        "role": "Source code hosting and version control",
        "issues": [],
        "secrets": [
          "gitea_admin_password"
        ],
        "behaviors": [],
        "services": [
          "http",
          "ssh"
        ]
      }
    },
    "jenkins_runner": {
      "name": "jenkins_runner",
      "kind": "runtime",
      "deploy": {
        "image": "jenkins/jenkins:lts",
        "zone": "build_zone",
        "ports": [
          50000,
          8080
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "gitea",
          "container_registry",
          "ci_database"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost:8080/login || wget -qO- http://localhost:8080/login || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "jenkins.build.internal_developer_platform.internal",
        "role": "Continuous Integration/Continuous Deployment runner",
        "issues": [],
        "secrets": [
          "jenkins_admin_password"
        ],
        "behaviors": [],
        "services": [
          "http",
          "agent"
        ]
      }
    },
    "container_registry": {
      "name": "container_registry",
      "kind": "storage",
      "deploy": {
        "image": "minio/minio:latest",
        "zone": "internal_zone",
        "ports": [
          9000
        ],
        "env": [
          "MINIO_ACCESS_KEY=admin",
          "MINIO_SECRET_KEY=admin123"
        ],
        "volumes": [],
        "depends_on": [],
        "command": [
          "minio",
          "server",
          "/data"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 9000 || (echo > /dev/tcp/localhost/9000) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "registry.internal_developer_platform.internal",
