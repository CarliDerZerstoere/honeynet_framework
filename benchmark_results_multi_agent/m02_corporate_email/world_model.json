{
  "zones": {
    "public_zone": {
      "name": "public_zone",
      "deploy": {
        "network_name": "public_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "internal_zone": {
      "name": "internal_zone",
      "deploy": {
        "network_name": "internal_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "dmz_zone": {
      "name": "dmz_zone",
      "deploy": {
        "network_name": "dmz_zone",
        "driver": "bridge",
        "internal": false
      }
    }
  },
  "systems": {
    "webmail_portal": {
      "name": "webmail_portal",
      "kind": "web",
      "deploy": {
        "image": "nginx:1.25-alpine",
        "zone": "public_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "mail_server"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost/ || wget -qO- http://localhost/ || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "webmail.corporate_email_infrastructure.com",
        "role": "Public-facing webmail portal",
        "issues": [],
        "secrets": [
          "webmail_admin_password"
        ],
        "behaviors": [],
        "services": [
          "http"
        ]
      }
    },
    "mail_server": {
      "name": "mail_server",
      "kind": "runtime",
      "deploy": {
        "image": "osixia/openldap:1.5.0",
        "zone": "internal_zone",
        "ports": [
          389,
          636
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "ldap_directory",
          "file_storage"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 389 || (echo > /dev/tcp/localhost/389) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "mail.internal.corporate_email_infrastructure.com",
        "role": "Internal SMTP/IMAP mail server",
        "issues": [],
        "secrets": [
          "mail_admin_password"
        ],
        "behaviors": [],
        "services": [
          "smtp",
          "imap"
        ]
      }
    },
