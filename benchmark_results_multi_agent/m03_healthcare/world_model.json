      "name": "patient_db",
      "kind": "database",
      "deploy": {
        "image": "postgres:16-alpine",
        "zone": "data_zone",
        "ports": [
          5432
        ],
        "env": [
          "POSTGRES_PASSWORD=admin123"
        ],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "pg_isready",
