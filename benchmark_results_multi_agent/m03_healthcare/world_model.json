{
  "zones": {
    "public_zone": {
      "name": "public_zone",
      "deploy": {
        "network_name": "public_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "internal_zone": {
      "name": "internal_zone",
      "deploy": {
        "network_name": "internal_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    }
  },
  "systems": {
    "patient_portal": {
      "name": "patient_portal",
      "kind": "web",
      "deploy": {
        "image": "drupal:10-apache",
        "zone": "public_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost/"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "portal.hipaa_healthcare_it.org",
        "role": "Public-facing patient portal for accessing personal health information",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "fhir_service": {
      "name": "fhir_service",
      "kind": "web",
      "deploy": {
