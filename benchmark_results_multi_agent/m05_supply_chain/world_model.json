    "vendor_portal": {
      "name": "vendor_portal",
      "kind": "web",
      "deploy": {
        "image": "drupal:10-apache",
        "zone": "public_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost/ || wget -qO- http://localhost/ || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "vendorportal.corporate_supply_chain.com",
        "role": "Public vendor self-service portal",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
