{
  "zones": {
    "public_zone": {
      "name": "public_zone",
      "deploy": {
        "network_name": "public_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "internal_zone": {
      "name": "internal_zone",
      "deploy": {
        "network_name": "internal_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    }
