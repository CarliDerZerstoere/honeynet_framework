{
  "zones": {
    "public_zone": {
      "name": "public_zone",
      "deploy": {
        "network_name": "public_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "game_zone": {
      "name": "game_zone",
      "deploy": {
        "network_name": "game_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "monitoring_zone": {
      "name": "monitoring_zone",
      "deploy": {
        "network_name": "monitoring_zone",
        "driver": "bridge",
        "internal": true
      }
    }
