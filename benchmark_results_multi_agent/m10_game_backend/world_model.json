  "systems": {
    "redis_session_store": {
      "name": "redis_session_store",
      "kind": "database",
      "deploy": {
        "image": "redis:7-alpine",
        "zone": "game_zone",
        "ports": [
          6379
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "redis-cli",
            "ping"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "redis-session-store.game.multiplayergame.internal",
        "role": "Stores active player sessions",
        "issues": [],
        "secrets": [
          "redis_password"
        ],
        "behaviors": [],
        "services": []
      }
    },
    "postgres_player_db": {
      "name": "postgres_player_db",
      "kind": "database",
      "deploy": {
        "image": "postgres:16-alpine",
        "zone": "data_zone",
        "ports": [
          5432
        ],
        "env": [
          "POSTGRES_PASSWORD=admin123"
        ],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "pg_isready",
            "-U",
            "postgres"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "postgres-player-db.data.multiplayergame.internal",
