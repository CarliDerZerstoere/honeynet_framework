      "name": "identity_service",
      "kind": "identity",
      "deploy": {
        "image": "osixia/openldap:1.5.0",
        "zone": "security_zone",
        "ports": [
          389,
          636
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 389 || (echo > /dev/tcp/localhost/389) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "identity-service.security.corporate_data_lake.internal",
        "role": "Manages user identities and authentication",
        "issues": [],
        "secrets": [
          "ldap_admin_password"
        ],
        "behaviors": [],
        "services": []
      }
