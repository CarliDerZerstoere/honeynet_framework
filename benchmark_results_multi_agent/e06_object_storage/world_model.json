      },
      "simulate": {
        "hostname": "alerting-service.monitoring.corporate_data_lake.internal",
        "role": "Handles alerts based on monitoring data",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
