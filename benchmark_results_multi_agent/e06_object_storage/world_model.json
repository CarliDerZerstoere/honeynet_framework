      "name": "log_collector",
      "kind": "monitor",
      "deploy": {
        "image": "clickhouse/clickhouse-server:23.12",
        "zone": "monitoring_zone",
        "ports": [
          8123,
          9000,
          9009
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "clickhouse-client --query 'SELECT 1'"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
