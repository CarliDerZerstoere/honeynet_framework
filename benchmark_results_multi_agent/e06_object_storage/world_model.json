        "zone": "monitoring_zone",
        "ports": [
          27017
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "monitoring_collector"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "mongo",
            "--eval",
