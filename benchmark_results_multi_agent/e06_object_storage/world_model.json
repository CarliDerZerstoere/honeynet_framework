{
  "zones": {
    "app_zone": {
      "name": "app_zone",
      "deploy": {
        "network_name": "app_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "monitoring_zone": {
      "name": "monitoring_zone",
      "deploy": {
        "network_name": "monitoring_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "security_zone": {
      "name": "security_zone",
      "deploy": {
        "network_name": "security_zone",
        "driver": "bridge",
        "internal": true
      }
    }
  },
  "systems": {
    "api_gateway": {
      "name": "api_gateway",
      "kind": "web",
      "deploy": {
        "image": "caddy:2",
        "zone": "app_zone",
        "ports": [
          80,
          443
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "object_storage",
          "metadata_db"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost/"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "api-gateway.app.corporate_data_lake.internal",
        "role": "Handles incoming API requests and routes them to appropriate services",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "web_frontend": {
      "name": "web_frontend",
      "kind": "web",
      "deploy": {
        "image": "nginx:1.25-alpine",
        "zone": "app_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "api_gateway"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost/"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "web-frontend.app.corporate_data_lake.internal",
        "role": "Serves the main web application interface to users",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "object_storage": {
      "name": "object_storage",
      "kind": "storage",
      "deploy": {
        "image": "minio/minio:latest",
        "zone": "data_zone",
        "ports": [
          9000
        ],
        "env": [
          "MINIO_ROOT_USER=minioadmin",
          "MINIO_ROOT_PASSWORD=minioadmin"
        ],
        "volumes": [],
        "depends_on": [],
        "command": [
          "minio",
          "server",
          "/data"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost:9000/minio/health/live"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "object-storage.data.corporate_data_lake.internal",
        "role": "S3-compatible storage for internal data lake services",
        "issues": [],
        "secrets": [
          "object_storage_admin_password"
        ],
        "behaviors": [],
        "services": []
      }
    },
    "metadata_db": {
      "name": "metadata_db",
      "kind": "database",
      "deploy": {
        "image": "mysql:8.0",
        "zone": "data_zone",
        "ports": [
          3306,
          33060
        ],
        "env": [
          "MYSQL_ROOT_PASSWORD=admin123",
          "MYSQL_DATABASE=metadata"
        ],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "mysqladmin",
            "ping",
            "-h",
            "localhost"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "metadata-db.data.corporate_data_lake.internal",
        "role": "Stores metadata information for the data lake",
        "issues": [],
        "secrets": [
          "metadata_db_root_password"
        ],
        "behaviors": [],
        "services": []
      }
    },
    "monitoring_collector": {
      "name": "monitoring_collector",
      "kind": "monitor",
      "deploy": {
        "image": "nginx:1.25-alpine",
        "zone": "monitoring_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "object_storage",
