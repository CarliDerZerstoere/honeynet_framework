      "hn_traffic_api": {
        "name": "hn_traffic_api",
        "image": "${docker_image.hn_traffic_api.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.smart_city_infrastructure_public_zone.name}",
            "aliases": [
              "traffic_api"
            ]
          },
          {
            "name": "${docker_network.smart_city_infrastructure_data_zone.name}",
            "aliases": [
              "traffic_api"
            ]
          }
        ],
        "hostname": "traffic-api.public.smartcity.internal",
        "ports": [
          {
            "internal": 80,
            "external": 1025,
            "protocol": "tcp"
          }
        ],
        "depends_on": [
          "docker_container.hn_metrics_db"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "smart_city_infrastructure"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD",
              "wget",
              "--spider",
              "http://localhost/"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_metrics_db": {
        "name": "hn_metrics_db",
        "image": "${docker_image.hn_metrics_db.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.smart_city_infrastructure_data_zone.name}",
            "aliases": [
              "metrics_db"
            ]
          }
        ],
        "hostname": "metrics-db.data.smartcity.internal",
        "env": [
          "INFLUXDB_ADMIN_USER=admin",
          "INFLUXDB_ADMIN_PASSWORD=password"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "smart_city_infrastructure"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD",
              "influx",
              "ping"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
