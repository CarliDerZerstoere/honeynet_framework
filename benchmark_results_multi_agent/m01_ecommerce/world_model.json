  "systems": {
    "web_storefront": {
      "name": "web_storefront",
      "kind": "web",
      "deploy": {
        "image": "ghost:5",
        "zone": "internal_zone",
        "ports": [
          2368
        ],
        "env": [
          "database__client=mysql",
          "database__connection__host=mysql",
          "database__connection__user=root",
          "database__connection__password=weakpassword",
          "database__connection__database=ghost_db",
          "NODE_ENV=production",
          "GHOST_INSTALL=/var/lib/ghost",
          "GHOST_CONTENT=/var/lib/ghost",
          "GHOST_VERSION=5.130.6",
          "GHOST_CLI_VERSION=1.28.4",
          "NODE_VERSION=20.20.0",
          "YARN_VERSION=1.22.22",
          "GOSU_VERSION=1.19",
          "DATABASE_HOST=mysql"
        ],
        "volumes": [],
        "depends_on": [
          "redis_cart"
        ],
        "command": [
          "node",
          "current/index.js"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost:2368"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "storefront.midshop.internal",
        "role": "Public web storefront for customer interactions",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
