        "hostname": "pgadmin.midshop.internal",
        "env": [
          "PGADMIN_DEFAULT_EMAIL=admin@midshop.internal",
          "PGADMIN_DEFAULT_PASSWORD=pgadminpass"
        ],
        "depends_on": [
          "docker_container.hn_orders_db"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "mid_size_ecommerce_company"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "curl -sf http://localhost/ || wget -qO- http://localhost/ || true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_filebeat": {
        "name": "hn_filebeat",
        "image": "${docker_image.hn_filebeat.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.mid_size_ecommerce_company_internal_zone.name}",
            "aliases": [
              "filebeat"
            ]
          }
        ],
        "hostname": "filebeat.midshop.internal",
        "depends_on": [
          "docker_container.hn_log_collector"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "mid_size_ecommerce_company"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      }
    }
  }
}