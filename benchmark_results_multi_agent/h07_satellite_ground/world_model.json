{
  "zones": {
    "ops_zone": {
      "name": "ops_zone",
      "deploy": {
        "network_name": "ops_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "telemetry_zone": {
      "name": "telemetry_zone",
      "deploy": {
        "network_name": "telemetry_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "command_zone": {
      "name": "command_zone",
      "deploy": {
        "network_name": "command_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "data_zone": {
      "name": "data_zone",
      "deploy": {
        "network_name": "data_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "security_zone": {
      "name": "security_zone",
      "deploy": {
        "network_name": "security_zone",
        "driver": "bridge",
        "internal": true
      }
    }
  },
  "systems": {
    "mission_control_dashboard": {
      "name": "mission_control_dashboard",
      "kind": "web",
      "deploy": {
        "image": "grafana/grafana:10.2.0",
        "zone": "ops_zone",
        "ports": [
          3000
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD",
            "wget",
            "--spider",
            "http://localhost:3000/api/health"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "dashboard.ops.satellite_ground_station.internal",
        "role": "Provides a web interface for mission control operations",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "prometheus_monitoring": {
      "name": "prometheus_monitoring",
      "kind": "monitor",
      "simulate": {
        "hostname": "prometheus.security.satellite_ground_station.internal",
        "role": "Monitors system metrics and performance",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "grafana_dashboard": {
      "name": "grafana_dashboard",
      "kind": "monitor",
      "deploy": {
        "image": "grafana/grafana:10.2.0",
        "zone": "security_zone",
        "ports": [
          3000
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "prometheus_monitoring"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost:3000/ || wget -qO- http://localhost:3000/ || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "grafana.security.satellite_ground_station.internal",
        "role": "Visualizes monitoring data and system metrics",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "admin_panel": {
      "name": "admin_panel",
      "kind": "web",
      "deploy": {
        "image": "phpmyadmin:5.2",
        "zone": "ops_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost/ || wget -qO- http://localhost/ || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "admin.ops.satellite_ground_station.internal",
        "role": "Web-based administration panel for managing databases",
        "issues": [],
        "secrets": [
          "admin_panel_password"
        ],
        "behaviors": [],
        "services": []
      }
    },
    "monitoring_agent": {
      "name": "monitoring_agent",
      "kind": "monitor",
      "deploy": {
        "image": "prom/prometheus:v2.48.0",
        "zone": "telemetry_zone",
        "ports": [
          9090
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "prometheus_monitoring"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "wget",
            "--spider",
            "http://localhost:9090/-/healthy"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "agent.telemetry.satellite_ground_station.internal",
        "role": "Collects telemetry data for monitoring and alerting",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "service_discovery": {
      "name": "service_discovery",
      "kind": "infra",
      "deploy": {
        "image": "hashicorp/consul:1.17",
        "zone": "telemetry_zone",
        "ports": [
          8300,
          8301,
          8302,
          8500,
          8600
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "consul members | grep -q alive"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "discovery.telemetry.satellite_ground_station.internal",
        "role": "Facilitates service discovery and health checks",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "log_collector": {
      "name": "log_collector",
      "kind": "monitor",
      "deploy": {
        "image": "grafana/loki:2.9.3",
        "zone": "telemetry_zone",
        "ports": [
          3100
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 3100 || (echo > /dev/tcp/localhost/3100) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "loki.telemetry.satellite_ground_station.internal",
        "role": "Collects and aggregates logs from various services",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "telemetry_dashboard": {
      "name": "telemetry_dashboard",
      "kind": "web",
      "deploy": {
        "image": "grafana/grafana:10.2.0",
        "zone": "ops_zone",
        "ports": [
          3000
        ],
        "env": [],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost:3000/ || wget -qO- http://localhost:3000/ || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "telemetry-dashboard.ops.satellite_ground_station.internal",
        "role": "Displays telemetry data and system status to operators",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "fluentd": {
      "name": "fluentd",
      "kind": "monitor",
      "deploy": {
        "image": "fluent/fluentd:v1.14-1",
        "zone": "security_zone",
        "ports": [
          24224
        ],
        "env": [
          "FLUENTD_CONF=fluent.conf",
          "LD_PRELOAD=default"
        ],
        "volumes": [],
        "depends_on": [
          "log_collector"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "fluentd.security.satellite_ground_station.internal",
        "role": "Log collector and forwarder for centralized logging",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    }
  },
