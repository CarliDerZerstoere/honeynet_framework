{
  "terraform": {
    "required_providers": {
      "docker": {
        "source": "registry.terraform.io/kreuzwerker/docker",
        "version": "3.6.2"
      }
    }
  },
  "provider": [
    {
      "docker": [
        {
          "host": "npipe:////./pipe/docker_engine"
        }
      ]
    }
  ],
  "resource": {
    "docker_network": {
      "satellite_ground_station_ops_zone": {
        "name": "satellite_ground_station_ops_zone",
        "driver": "bridge",
        "internal": false
      },
      "satellite_ground_station_telemetry_zone": {
        "name": "satellite_ground_station_telemetry_zone",
        "driver": "bridge",
        "internal": true
      },
      "satellite_ground_station_command_zone": {
        "name": "satellite_ground_station_command_zone",
        "driver": "bridge",
        "internal": true
      },
      "satellite_ground_station_data_zone": {
        "name": "satellite_ground_station_data_zone",
        "driver": "bridge",
        "internal": true
      },
      "satellite_ground_station_security_zone": {
        "name": "satellite_ground_station_security_zone",
        "driver": "bridge",
        "internal": true
      },
      "satellite_ground_station_honeynet_backbone": {
        "name": "satellite_ground_station_honeynet_backbone",
        "driver": "bridge",
        "internal": false
      }
    },
    "docker_image": {
      "hn_mission_control_dashboard": {
        "name": "grafana/grafana@sha256:1ee0c54286b8ca09a3dd1419ff8653e7780a148a006ac088544203bb0affe550",
        "keep_locally": true
      },
      "hn_grafana_dashboard": {
        "name": "grafana/grafana@sha256:1ee0c54286b8ca09a3dd1419ff8653e7780a148a006ac088544203bb0affe550",
        "keep_locally": true
      },
      "hn_admin_panel": {
        "name": "phpmyadmin@sha256:f3a5bfe8dbe509a2c9706c03c0ab9f82a74b0f2cb855f4b45a67f644d5368d5a",
        "keep_locally": true
      },
      "hn_monitoring_agent": {
        "name": "prom/prometheus@sha256:b440bc0e8aa5bab44a782952c09516b6a50f9d7b2325c1ffafac7bc833298e2e",
        "keep_locally": true
      },
      "hn_service_discovery": {
        "name": "hashicorp/consul@sha256:fa5020e2307bc941e4317207de1ab55f2c7a8cd6b02c0592cce1cd20ec8a7f87",
        "keep_locally": true
      },
      "hn_log_collector": {
        "name": "grafana/loki@sha256:eb92f1a439171542fd718f929fad38c917b3cad15ec830ba4742e2ba5ab03313",
        "keep_locally": true
      },
      "hn_telemetry_dashboard": {
        "name": "grafana/grafana@sha256:1ee0c54286b8ca09a3dd1419ff8653e7780a148a006ac088544203bb0affe550",
        "keep_locally": true
      },
      "hn_fluentd": {
        "name": "fluent/fluentd@sha256:3e0bd37d74c95cff04a5a70ca4bb7470c6f807075cb914c1267c89f5801e1333",
        "keep_locally": true
      }
    },
    "docker_container": {
      "hn_mission_control_dashboard": {
        "name": "hn_mission_control_dashboard",
        "image": "${docker_image.hn_mission_control_dashboard.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.satellite_ground_station_ops_zone.name}",
            "aliases": [
              "mission_control_dashboard"
            ]
          }
        ],
        "hostname": "dashboard.ops.satellite_ground_station.internal",
        "ports": [
          {
            "internal": 3000,
            "external": 3002,
            "protocol": "tcp"
          }
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "satellite_ground_station"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD",
              "wget",
              "--spider",
              "http://localhost:3000/api/health"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_grafana_dashboard": {
        "name": "hn_grafana_dashboard",
        "image": "${docker_image.hn_grafana_dashboard.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.satellite_ground_station_security_zone.name}",
            "aliases": [
              "grafana_dashboard"
            ]
          }
        ],
        "hostname": "grafana.security.satellite_ground_station.internal",
        "labels": [
          {
            "label": "honeynet.project",
            "value": "satellite_ground_station"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "curl -sf http://localhost:3000/ || wget -qO- http://localhost:3000/ || true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_admin_panel": {
        "name": "hn_admin_panel",
        "image": "${docker_image.hn_admin_panel.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.satellite_ground_station_ops_zone.name}",
            "aliases": [
              "admin_panel"
            ]
          }
        ],
        "hostname": "admin.ops.satellite_ground_station.internal",
        "ports": [
          {
            "internal": 80,
            "external": 1025,
            "protocol": "tcp"
          }
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "satellite_ground_station"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "curl -sf http://localhost/ || wget -qO- http://localhost/ || true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_monitoring_agent": {
        "name": "hn_monitoring_agent",
        "image": "${docker_image.hn_monitoring_agent.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.satellite_ground_station_telemetry_zone.name}",
            "aliases": [
              "monitoring_agent"
            ]
          }
        ],
        "hostname": "agent.telemetry.satellite_ground_station.internal",
        "labels": [
          {
            "label": "honeynet.project",
            "value": "satellite_ground_station"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD",
              "wget",
              "--spider",
              "http://localhost:9090/-/healthy"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_service_discovery": {
        "name": "hn_service_discovery",
        "image": "${docker_image.hn_service_discovery.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.satellite_ground_station_telemetry_zone.name}",
            "aliases": [
              "service_discovery"
            ]
          }
        ],
        "hostname": "discovery.telemetry.satellite_ground_station.internal",
        "labels": [
          {
            "label": "honeynet.project",
            "value": "satellite_ground_station"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "consul members | grep -q alive"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_log_collector": {
        "name": "hn_log_collector",
        "image": "${docker_image.hn_log_collector.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.satellite_ground_station_telemetry_zone.name}",
            "aliases": [
              "log_collector"
            ]
          }
        ],
        "hostname": "loki.telemetry.satellite_ground_station.internal",
        "labels": [
          {
            "label": "honeynet.project",
            "value": "satellite_ground_station"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "nc -z localhost 3100 || (echo > /dev/tcp/localhost/3100) 2>/dev/null || true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_telemetry_dashboard": {
        "name": "hn_telemetry_dashboard",
        "image": "${docker_image.hn_telemetry_dashboard.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.satellite_ground_station_ops_zone.name}",
            "aliases": [
              "telemetry_dashboard"
            ]
          }
        ],
        "hostname": "telemetry-dashboard.ops.satellite_ground_station.internal",
        "ports": [
          {
            "internal": 3000,
            "external": 3003,
            "protocol": "tcp"
          }
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "satellite_ground_station"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "curl -sf http://localhost:3000/ || wget -qO- http://localhost:3000/ || true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      },
      "hn_fluentd": {
        "name": "hn_fluentd",
        "image": "${docker_image.hn_fluentd.image_id}",
        "networks_advanced": [
          {
            "name": "${docker_network.satellite_ground_station_security_zone.name}",
            "aliases": [
              "fluentd"
            ]
          },
          {
            "name": "${docker_network.satellite_ground_station_telemetry_zone.name}",
            "aliases": [
              "fluentd"
            ]
          }
        ],
        "hostname": "fluentd.security.satellite_ground_station.internal",
        "env": [
          "FLUENTD_CONF=fluent.conf",
          "LD_PRELOAD=default"
        ],
        "depends_on": [
          "docker_container.hn_log_collector"
        ],
        "labels": [
          {
            "label": "honeynet.project",
            "value": "satellite_ground_station"
          },
          {
            "label": "honeynet.managed",
            "value": "true"
          }
        ],
        "healthcheck": [
          {
            "test": [
              "CMD-SHELL",
              "true"
            ],
            "interval": "30s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "30s"
          }
        ]
      }
    }
  }
}