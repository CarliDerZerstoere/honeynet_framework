          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "lims_api"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "curl",
            "-f",
            "http://localhost/"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "labportal.pharmaceutical_research_lab.internal",
        "role": "Scientist web portal for accessing lab management tools",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
