        "volumes": [],
        "depends_on": [
          "nextcloud_backend"
        ],
        "command": [
          "minio",
          "server",
          "/data"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "mc",
            "alias",
            "set",
            "myminio",
