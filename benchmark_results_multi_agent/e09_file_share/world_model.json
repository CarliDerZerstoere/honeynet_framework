{
  "zones": {
    "dmz_zone": {
      "name": "dmz_zone",
      "deploy": {
        "network_name": "dmz_zone",
        "driver": "bridge",
        "internal": false
      }
    },
    "backend_zone": {
      "name": "backend_zone",
      "deploy": {
        "network_name": "backend_zone",
        "driver": "bridge",
        "internal": true
      }
    },
    "monitoring_zone": {
      "name": "monitoring_zone",
      "deploy": {
        "network_name": "monitoring_zone",
        "driver": "bridge",
        "internal": true
      }
    }
  },
  "systems": {
    "nextcloud_frontend": {
      "name": "nextcloud_frontend",
      "kind": "web",
      "deploy": {
        "image": "nginx:1.25-alpine",
        "zone": "dmz_zone",
        "ports": [
          80
        ],
        "env": [],
        "volumes": [],
        "depends_on": [
          "nextcloud_backend",
          "ldap_server",
          "clamav_scanner"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "curl -sf http://localhost/ || wget -qO- http://localhost/ || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "nextcloud-web.dmz.corporatefilesharing.internal",
        "role": "Nextcloud web frontend for file sharing",
        "issues": [],
        "secrets": [],
        "behaviors": [],
        "services": []
      }
    },
    "nextcloud_backend": {
      "name": "nextcloud_backend",
      "kind": "storage",
      "deploy": {
        "image": "postgres:16-alpine",
        "zone": "backend_zone",
        "ports": [
          5432
        ],
        "env": [
          "POSTGRES_PASSWORD=admin123"
        ],
        "volumes": [],
        "depends_on": [
          "ldap_server",
          "clamav_scanner"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "pg_isready",
            "-U",
            "postgres"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "nextcloud-db.backend.corporatefilesharing.internal",
        "role": "PostgreSQL database for Nextcloud",
        "issues": [],
        "secrets": [
          "db_admin_password"
        ],
        "behaviors": [],
        "services": []
      }
    },
    "ldap_server": {
      "name": "ldap_server",
      "kind": "identity",
      "deploy": {
        "image": "osixia/openldap:1.5.0",
        "zone": "backend_zone",
        "ports": [
          389,
          636
        ],
        "env": [
          "LDAP_ADMIN_PASSWORD=admin123"
        ],
        "volumes": [],
        "depends_on": [],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "nc -z localhost 389 || (echo > /dev/tcp/localhost/389) 2>/dev/null || true"
          ],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "30s"
        }
      },
      "simulate": {
        "hostname": "ldap.backend.corporatefilesharing.internal",
        "role": "LDAP server for user authentication",
        "issues": [],
        "secrets": [
          "ldap_admin_password"
        ],
        "behaviors": [],
        "services": []
      }
    },
