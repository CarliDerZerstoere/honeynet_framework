      "kind": "monitor",
      "deploy": {
        "image": "docker.elastic.co/beats/filebeat:7.15.2",
        "zone": "monitoring_zone",
        "ports": [],
        "env": [
          "ELASTIC_CONTAINER=true",
          "GODEBUG=madvdontneed=1",
          "LIBBEAT_MONITORING_CGROUPS_HIERARCHY_OVERRIDE=/"
